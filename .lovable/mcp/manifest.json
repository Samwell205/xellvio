        "name": "get_account_summary",
        "title": "Get account summary",
        "description": "Get the signed-in Xellvio account: company, credit balance and sending status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_campaigns",
        "title": "List campaigns",
        "description": "List the signed-in user's SMS campaigns, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many campaigns to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "status": {
              "description": "Optional status filter, e.g. draft, sending, completed.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_campaign_report",
