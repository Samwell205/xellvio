# ---------------------------------------------------------------------------
# Xellvio — local / self-hosted environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Supabase (your own project) -------------------------------------------
# Browser-visible (safe to ship to the client)
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon / publishable key>"
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"

# Server-only (same values as above, read by server functions / SSR)
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon / publishable key>"
SUPABASE_PROJECT_ID="<your-project-ref>"
# NEVER expose this one to the browser
SUPABASE_SERVICE_ROLE_KEY="<service role key>"

# --- Public URLs -----------------------------------------------------------
# Used for shortlinks, invite links, opt-in proof links, webhook callbacks.
# In production this must be the live site origin, no trailing slash.
PUBLIC_BASE_URL="http://localhost:8080"
PUBLIC_SITE_URL="http://localhost:8080"
SITE_URL="http://localhost:8080"

# --- SMS / carrier ---------------------------------------------------------
TELNYX_API_KEY="<carrier api key>"
# Public key used to verify inbound + status webhook signatures
TELNYX_PUBLIC_KEY="<carrier webhook public key>"

# --- Payments --------------------------------------------------------------
PAYSTACK_SECRET_KEY="sk_live_..."
NOWPAYMENTS_API_KEY="<nowpayments api key>"
NOWPAYMENTS_IPN_SECRET="<nowpayments ipn secret>"
NOWPAYMENTS_IPN_URL="https://<your-domain>/api/public/nowpayments-ipn"

# --- Web push (admin PWA notifications) ------------------------------------
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="<vapid public key>"
VAPID_PRIVATE_KEY="<vapid private key>"
VAPID_SUBJECT="mailto:support@xellvio.com"

# --- Encryption ------------------------------------------------------------
# 32-byte key (base64 or hex) used to encrypt tenant carrier tokens at rest.
# Must stay identical to the value used when the tokens were written.
TENANT_TOKEN_ENCRYPTION_KEY="<32-byte key>"

# --- AI (content screening + support chat) ---------------------------------
# Self-hosted: Anthropic Claude is used whenever ANTHROPIC_API_KEY is set.
# Without it the app falls back to the managed Lovable AI Gateway key.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Email -----------------------------------------------------------------
# Self-hosted: Resend is used whenever RESEND_API_KEY is set (both the direct
# send path and the pgmq queue worker). Verify xellvio.com (or
# notify.xellvio.com) in Resend first.
RESEND_API_KEY=""
EMAIL_FROM="Xellvio <admin@xellvio.com>"
# Used to build unsubscribe links in Resend-sent emails.
PUBLIC_SITE_URL="https://xellvio.com"
